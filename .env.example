# Mapa canonico de portas/URLs do Modulo 5 (copie para .env e ajuste se preciso).
# As 4 apps sobem localmente em portas fixas:
#
#   Interface-e-Nuvem (Flask, hub/portal) : 5000
#   Perfis-Usuarios   (FastAPI)           : 5002
#   IA-Analise-Codigo (FastAPI)           : 8001
#   Gerador-Documentacao (FastAPI)        : 8000

# --- Interface-e-Nuvem (BFF): para onde o portal chama ---
PERFIS_URL=http://localhost:5002
IA_ANALISE_URL=http://localhost:8001
GERADOR_URL=http://localhost:8000
HTTP_TIMEOUT=5
# Timeout do fluxo unificado ao chamar o Gerador (pipeline GitHub+IA+mermaid.ink)
DIAGRAMA_TIMEOUT_SEGUNDOS=40

# --- Gerador-Documentacao: ele chama a IA ---
# (use a MESMA porta real da IA - 8001)
# IA_ANALISE_URL=http://localhost:8001

# --- GitHub (opcional, evita rate-limit anonimo ao buscar arquivos) ---
# GITHUB_TOKEN=

# --- IA-Analise (opcional, sem chave roda em modo fake/dev) ---
# GEMINI_API_KEY=

# ==========================================================================
# Producao / Azure App Service
# ==========================================================================
# Setar como "Environment variables / App settings" no Portal do Azure de
# CADA App Service (sem barra "/" no final, Apply reinicia sozinho ~30s).
#
# >>> Modulo5-Interface-e-Nuvem (este servico) <<<
#   PERFIS_URL=https://modulo5-perfis-usuarios-d9hbc0aba6ape4ar.canadacentral-01.azurewebsites.net
#   IA_ANALISE_URL=https://modulo5-ia-analise-codigo.azurewebsites.net
#   GERADOR_URL=https://modulo5-gerador-documentacao.azurewebsites.net
#
# >>> Modulo5-Gerador-Documentacao <<<
#   IA_ANALISE_URL=https://modulo5-ia-analise-codigo.azurewebsites.net
#   GITHUB_TOKEN=<PAT do GitHub>            # opcional, recomendado
#
# >>> Modulo5-IA-Analise-Codigo <<<
#   GEMINI_API_KEY=<chave aistudio.google.com>   # OBRIGATORIO
#   GITHUB_TOKEN=<PAT do GitHub>                 # recomendado
#
# >>> Modulo5-Perfis-Usuarios <<<
#   GITHUB_TOKEN=<PAT do GitHub>            # recomendado
#
# Por que? Sem essas variaveis o codigo cai no default os.getenv(..., "http://localhost:porta")
# e dentro do container Azure a chamada bate em localhost (que nao tem ninguem escutando),
# resultando em "FORA"/"DEGRADADO" no portal e Errno 99/timeout nas chamadas entre servicos.
