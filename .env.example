# Mapa canonico de portas/URLs do Modulo 5 (copie para .env e ajuste se preciso).
# As 4 apps sobem localmente em portas fixas:
#
#   Interface-e-Nuvem (Flask, hub/portal) : 5000
#   Perfis-Usuarios   (FastAPI)           : 5002
#   IA-Analise-Codigo (FastAPI)           : 8001
#   Gerador-Documentacao (FastAPI)        : 8000

# --- Interface-e-Nuvem (BFF): para onde o portal chama ---
PERFIS_URL=http://localhost:5002
IA_ANALISE_URL=http://localhost:8001
GERADOR_URL=http://localhost:8000
HTTP_TIMEOUT=5
# Timeout do fluxo unificado ao chamar o Gerador (pipeline GitHub+IA+mermaid.ink)
DIAGRAMA_TIMEOUT_SEGUNDOS=40

# --- Gerador-Documentacao: ele chama a IA ---
# (use a MESMA porta real da IA — 8001)
# IA_ANALISE_URL=http://localhost:8001

# --- GitHub (opcional, evita rate-limit anonimo ao buscar arquivos) ---
# GITHUB_TOKEN=

# --- IA-Analise (opcional, sem chave roda em modo fake/dev) ---
# GEMINI_API_KEY=
